# ==============================================================================
# 🛸 AVA NEXUS // Living Aurora — Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values according to your environment.

# --- SERVER & HOST NETWORK ---
AVA_HOST=0.0.0.0
SERVER_IP=localhost
TZ=Europe/Lisbon

# --- POSTGRESQL DATABASE ---
POSTGRES_USER=ava
POSTGRES_PASSWORD=ava_secure_password
POSTGRES_DB=ava
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ava:ava_secure_password@postgres:5432/ava

# --- MULTI-USER PIN AUTHENTICATION ---
# 4-digit security PINs for Cockpit lockscreen
AVA_PIN_ADMIN=1234
AVA_PIN_MEMBER=5678
AVA_USER_ADMIN=Alex
AVA_USER_MEMBER=Sam
AVA_DEVICE_TOKEN=ava-mobile-device-secret-token

# --- LOCAL AI & LLM ENGINE (Optional / Resilient) ---
# AVA connects to local Ollama. If offline, the built-in Circuit Breaker activates Autonomous Local Mode (< 10ms).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- DOCUMENT MANAGEMENT (Paperless-ngx - Optional) ---
# Connect your existing Paperless instance for automatic OCR, or use direct file upload in the app.
PAPERLESS_URL=http://localhost:8000
PAPERLESS_TOKEN=your_paperless_api_token_here

# --- CALENDAR & SCHEDULE SYNC (RFC 5545 iCalendar - Optional) ---
# Private iCal URL from Google Calendar, Proton Calendar or Nextcloud.
GOOGLE_CALENDAR_ICAL_URL=https://calendar.google.com/calendar/ical/example%40gmail.com/private-example/basic.ics

# --- WEATHER & METRICS (Open-Meteo) ---
METEO_LATITUDE=41.1579
METEO_LONGITUDE=-8.6291
METEO_CITY_NAME="Porto"
